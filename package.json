{
  "name": "cs-homepage",
  "private": true,
  "version": "0.1.7-alpha",
  "author": {
    "name": "William Bain"
  },
  "packageManager": "pnpm@12.8.1",
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "^7.28.6",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^10.0.1",
    "@types/animejs": "^3.1.13",
    "@types/debug": "^4.1.13",
    "@types/gtag.js": "^0.0.20",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/selenium-webdriver": "^4.35.7",
    "@types/twitter-for-web": "^0.0.6",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "autoprefixer": "^10.6.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "cssnano": "^9.2.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-webpack-plugin": "^6.0.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "mini-css-extract-plugin": "^2.10.2",
    "mini-svg-data-uri": "^1.4.4",
    "postcss": "^8.5.28",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "sass-loader": "^17.0.1",
    "selenium-webdriver": "^4.50.0",
    "semver": "^7.8.5",
    "style-loader": "^4.0.0",
    "stylelint": "^15.11.0",
    "stylelint-config-standard-scss": "^11.1.0",
    "stylelint-order": "^6.0.4",
    "svgo": "^4.1.0",
    "ts-loader": "^9.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  },
  "scripts": {
    "clean": "rm -rf content/home-assets/ content/section-partial/ _site/",
    "fmt": "prettier --write . && stylelint --fix src/scss && eslint --fix .",
    "lint": "eslint . && stylelint src/scss && prettier --check .",
    "pre-jekyll": "pnpm run lint-pre-jekyll && pnpm run build-pre-jekyll && pnpm run verify-bundled",
    "lint-pre-jekyll": "prettier --check . && stylelint src/scss",
    "build-pre-jekyll": "webpack --stats=verbose",
    "verify-bundled": "eslint --no-ignore --config eslint.config.bundled.js content/home-assets",
    "lint-build-infra": "eslint --ignore-pattern src/ .",
    "jekyll-build": "bundle exec jekyll build --source content",
    "jekyll-serve": "bundle exec jekyll serve --source content -H 0.0.0.0 -P 8080",
    "jekyll-lint": "bundle exec ruby build/jekyll-lint.rb",
    "tck": "tsc -p . && tsc -p integration-tests",
    "test": "jest"
  },
  "dependencies": {
    "@sentry/browser": "^10.43.0",
    "animejs": "^3.2.2",
    "debug": "^4.4.3",
    "normalize.css": "^8.0.1"
  }
}
